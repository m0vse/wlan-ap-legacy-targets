From: Phil Taylor <phil@localhost>
Subject: [PATCH] backports: honor OpenWrt MTD MAC properties

OpenWrt's legacy kernels extend of_get_mac_address() with support for the
mtd-mac-address device-tree property.  The backported device_get_mac_address()
implementation only checks literal firmware properties, bypassing that
extension and causing ath10k to choose random addresses.

Fall back to of_get_mac_address() after the literal property lookup so radios
can obtain their factory addresses from flash.  Existing firmware properties
retain their current priority.

--- a/compat/backport-4.3.c
+++ b/compat/backport-4.3.c
@@ -18,6 +18,7 @@
 #include <linux/property.h>
 #include <linux/etherdevice.h>
 #include <linux/of.h>
+#include <linux/of_net.h>
 
 #ifdef CONFIG_THERMAL
 #if LINUX_VERSION_IS_GEQ(3,8,0)
@@ -290,6 +291,7 @@
 void *device_get_mac_address(struct device *dev, char *addr, int alen)
 {
 	char *res;
+	const void *mac;
 
 	res = device_get_mac_addr(dev, "mac-address", addr, alen);
 	if (res)
@@ -299,6 +301,18 @@
 	if (res)
 		return res;
 
-	return device_get_mac_addr(dev, "address", addr, alen);
+	res = device_get_mac_addr(dev, "address", addr, alen);
+	if (res)
+		return res;
+
+	if (!dev->of_node || alen != ETH_ALEN)
+		return NULL;
+
+	mac = of_get_mac_address(dev->of_node);
+	if (IS_ERR_OR_NULL(mac))
+		return NULL;
+
+	ether_addr_copy(addr, mac);
+	return addr;
 }
 EXPORT_SYMBOL_GPL(device_get_mac_address);

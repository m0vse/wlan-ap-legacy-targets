From: Phil Taylor <phil@localhost>
Subject: [PATCH] ath10k: honor OpenWrt MTD MAC properties

OpenWrt's legacy kernels extend of_get_mac_address() with support for the
mtd-mac-address device-tree property.  The generic device property helper
does not use that extension, causing ath10k to reject the factory address
and choose a random one.

Use the OF helper first when probing a device-tree device, while retaining
the generic helper as a fallback for other firmware descriptions.  Some old
ath10k-ct paths still reach mac80211 registration with an invalid address, so
repeat the OF lookup immediately before validating the permanent address.

--- a/ath10k-5.7/core.c
+++ b/ath10k-5.7/core.c
@@ -7,6 +7,7 @@
 #include <linux/module.h>
 #include <linux/firmware.h>
 #include <linux/of.h>
+#include <linux/of_net.h>
 #include <linux/property.h>
 #include <linux/dmi.h>
 #include <linux/ctype.h>
@@ -3756,5 +3757,6 @@ static int ath10k_core_probe_fw(struct a
 {
 	struct bmi_target_info target_info;
+	const void *mac = NULL;
 	int ret = 0;
 
 	ret = ath10k_hif_power_up(ar, ATH10K_FIRMWARE_MODE_NORMAL);
@@ -3854,7 +3856,14 @@ static int ath10k_core_probe_fw(struct a
 		ath10k_debug_print_board_info(ar);
 	}
 
-	device_get_mac_address(ar->dev, ar->mac_addr, sizeof(ar->mac_addr));
+	if (ar->dev->of_node)
+		mac = of_get_mac_address(ar->dev->of_node);
+
+	if (IS_ERR_OR_NULL(mac))
+		device_get_mac_address(ar->dev, ar->mac_addr,
+				       sizeof(ar->mac_addr));
+	else
+		ether_addr_copy(ar->mac_addr, mac);
 
 	ret = ath10k_core_init_firmware_features(ar);
 	if (ret) {

--- a/ath10k-5.7/mac.c
+++ b/ath10k-5.7/mac.c
@@ -11,6 +11,7 @@
 #include <linux/bitfield.h>
 #include <linux/ctype.h>
 #include <linux/etherdevice.h>
+#include <linux/of_net.h>
 #include <linux/ratelimit.h>
 #include <linux/vmalloc.h>
 #include <linux/average.h>
@@ -10105,6 +10106,16 @@ int ath10k_mac_register(struct ath10k *a
 	void *channels;
 	int ret;
 
+	/* Retry the OF lookup at the point where mac80211's permanent address
+	 * is validated. OpenWrt's legacy MTD helper populates this property.
+	 */
+	if (!is_valid_ether_addr(ar->mac_addr) && ar->dev->of_node) {
+		const void *mac = of_get_mac_address(ar->dev->of_node);
+
+		if (!IS_ERR_OR_NULL(mac))
+			ether_addr_copy(ar->mac_addr, mac);
+	}
+
 	if (!is_valid_ether_addr(ar->mac_addr)) {
 		ath10k_warn(ar, "invalid MAC address; choosing random\n");
 		eth_random_addr(ar->mac_addr);
